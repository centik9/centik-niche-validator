# Placeholder only. Do not put real DataForSEO credentials in this file.
# Runtime secrets belong in the host environment, not in git.
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password

# Go-live account spend, set once. Derived as money.total - money.balance.
# Production baseline is 1.17145. A redeploy must not change this value.
# The cap is (current spend - this baseline + the quote) <= SPEND_CAP_USD.
# DATAFORSEO_SPENT_BASELINE_USD=

# Live billable calls stay off unless this is exactly the string true.
# TRUE, 1, yes, and an empty value do not enable live mode.
DATAFORSEO_LIVE=false

# Optional. Render sets PORT. The process binds 0.0.0.0.
# PORT=3000

# Total cap for paid calls, in USD. Default 10 when unset.
SPEND_CAP_USD=10

# Optional path for the JSON spend ledger. Default is ./data/spend-ledger.json.
# SPEND_LEDGER_PATH=

# HMAC key for one-time spend tokens. No default. Leave empty here.
SPEND_TOKEN_SECRET=

# Team sign-in. ALLOWED_EMAILS defaults to team@centik.ai when unset.
# Hash the access code with: node scripts/hash-access-code.mjs
ALLOWED_EMAILS=team@centik.ai
TEAM_ACCESS_CODE_HASH=
SESSION_SECRET=
